# Frontend Environment Variables (Vite)
# NOTE: Only variables prefixed with VITE_ are exposed to the client browser bundle.

# Production Backend API URL (leave empty or set to '/api' for local Vite dev proxy)
# In Vercel, set this to your deployed backend URL: e.g. https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Razorpay Key ID (Client-facing public key only - NEVER put key secret here)
# In Test mode, use a test key starting with rzp_test_
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
