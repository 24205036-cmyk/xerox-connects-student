# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend Origin for CORS (comma-separated if multiple, e.g. https://your-project.vercel.app,http://localhost:3000)
FRONTEND_URL=https://your-frontend.vercel.app

# Remote MySQL Database Configuration (Do NOT use localhost in production)
DB_HOST=your-cloud-mysql-host.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password
DB_NAME=xeroxpress_db
# Set DB_SSL=true if using cloud MySQL (Aiven, TiDB Cloud, Railway, PlanetScale, AWS RDS)
DB_SSL=true

# Alternative: Direct Database Connection URL (if provided by your cloud host)
# DATABASE_URL=mysql://user:password@host:port/database

# Authentication Secret (Generate a strong random string)
JWT_SECRET=your_jwt_secret_key_here

# Local Upload Directory
UPLOAD_DIR=./uploads

# Razorpay Payment Gateway (Test Mode: rzp_test_ / Live Mode: rzp_live_)
# CAUTION: Keep RAZORPAY_KEY_SECRET strictly on the backend!
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
